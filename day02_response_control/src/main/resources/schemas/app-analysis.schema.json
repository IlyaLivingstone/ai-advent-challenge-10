{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "audience", "features", "risk"],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 2
    },
    "audience": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "string",
        "minLength": 2
      }
    },
    "features": {
      "type": "array",
      "minItems": 3,
      "maxItems": 5,
      "items": {
        "type": "string",
        "minLength": 3
      }
    },
    "risk": {
      "type": "string",
      "minLength": 5
    }
  }
}
